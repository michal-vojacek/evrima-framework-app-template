# Settings of the website. Copy to .env for local development; never commit .env.
# On the deploy platform (DWM) the same keys go into the stack's settings
# (docs/deploy.md); docker-compose.yml passes them to the containers.

# --- Framework ---------------------------------------------------------------
# Exact Evrima release the deploy installs (a Git tag without the "v"). Never a
# range. Locally Evrima is installed editable from ../evrima-framework instead.
EVRIMA_VERSION=0.1.0

# production | development | testing  (docker-compose.yml sets production)
EVRIMA_ENV=development

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Data ----------------------------------------------------------------------
# Development: SQLite and in-process rate limits. In Docker the compose file
# builds DATABASE_URL and REDIS_URL itself; only POSTGRES_PASSWORD is needed.
DATABASE_URL=sqlite:///dev.sqlite3
REDIS_URL=memory://
# POSTGRES_PASSWORD=

# --- Hosts ---------------------------------------------------------------------
# The website's host names, comma-separated (required in production).
# SITE_HOSTS=example.com,www.example.com

# --- E-mail --------------------------------------------------------------------
# Outside production messages are printed to the console (PYTHONUTF8=1 on
# Windows, or the Czech letters come out broken). Production needs SMTP.
# MAIL_BACKEND=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_SENDER=

# Where enquiries from the contact form go (required).
CONTACT_RECIPIENT=info@example.com

# --- Telemetry (docs/telemetry.md) ----------------------------------------------
# Empty endpoint = off. The token is generated and named in the telemetry
# collector (evrima-telemetry) when the website is added there.
TELEMETRY_ENDPOINT=
TELEMETRY_TOKEN=
